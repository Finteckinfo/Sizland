{
  "buildCommand": "next build",
  "installCommand": "bun install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/solutions",
      "destination": "https://solutions.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/solutions/:path*",
      "destination": "https://solutions.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/solutions",
      "destination": "https://solutions.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    },
    {
      "source": "/solutions/:path*",
      "destination": "https://solutions.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    },
    {
      "source": "/buy-land",
      "destination": "https://buy.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/buy-land/:path*",
      "destination": "https://buy.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/buy-land",
      "destination": "https://buy.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    },
    {
      "source": "/buy-land/:path*",
      "destination": "https://buy.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    },
    {
      "source": "/mytab",
      "destination": "https://mytab.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/mytab/:path*",
      "destination": "https://mytab.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "siz.land" }]
    },
    {
      "source": "/mytab",
      "destination": "https://mytab.siz.land",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    },
    {
      "source": "/mytab/:path*",
      "destination": "https://mytab.siz.land/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.siz.land" }]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/solutions",
      "has": [{ "type": "host", "value": "solutions.siz.land" }]
    },
    {
      "source": "/",
      "destination": "/buy-land",
      "has": [{ "type": "host", "value": "buy.siz.land" }]
    },
    {
      "source": "/",
      "destination": "/mytab",
      "has": [{ "type": "host", "value": "mytab.siz.land" }]
    }
  ]
}
